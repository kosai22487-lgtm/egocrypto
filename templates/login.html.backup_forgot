        function showAnimatedTitle(text) {
            const el = document.getElementById('animated-title');
            if (!el) return;
            el.innerHTML = '';
            text.split('').forEach((char, i) => {
                const span = document.createElement('span');
                span.textContent = char;
                if (text === 'EgoCrypto') {
                    // First 3 letters (Ego) are white
                    // Rest (Crypto) is teal
                    span.className = 'bounce-letter ' + (i < 3 ? 'white' : 'teal');
                } else {
                    // For AI POWERED: first 2 letters (AI) white, rest yellow
                    span.className = 'bounce-letter ' + (i < 2 ? 'white' : 'yellow');
                }
                span.style.animationDelay = (i * 0.1) + 's';
                el.appendChild(span);
            });
        }
        function startTitleAnimation() {
            showAnimatedTitle(titleTexts[titleIndex]);
            titleInterval = setInterval(() => {
                titleIndex = (titleIndex + 1) % titleTexts.length;
