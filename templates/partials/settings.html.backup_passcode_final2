<script>
let currentUser = null;

function showSection(section) {
    const mainMenu = document.getElementById('main-menu');
    document.getElementById('account-section').classList.add('hidden');
    document.getElementById('security-section').classList.add('hidden');
    document.getElementById('app-customization-section').classList.add('hidden');
    document.getElementById('kyc-section').classList.add('hidden');
    if (section === 'account') {
        document.getElementById('account-section').classList.remove('hidden');
        mainMenu.classList.add('hidden');
    } else if (section === 'security') {
        document.getElementById('security-section').classList.remove('hidden');
        mainMenu.classList.add('hidden');
    } else if (section === 'kyc') {
        document.getElementById('kyc-section').classList.remove('hidden');
        mainMenu.classList.add('hidden');
    } else {
        mainMenu.classList.remove('hidden');
    }
}

function showAppCustomization() {
    document.getElementById('account-section').classList.add('hidden');
    document.getElementById('security-section').classList.add('hidden');
    document.getElementById('app-customization-section').classList.remove('hidden');
    document.getElementById('main-menu').classList.add('hidden');
}

function loadProfile() {
    fetch('/api/user/profile')
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                currentUser = data.user;
                if (currentUser.profile_pic) {
                    document.getElementById('profile-avatar').innerHTML = `<img src="${currentUser.profile_pic}" class="w-full h-full object-cover">`;
                }
                document.getElementById('real-name-display').innerText = currentUser.real_name || 'Not set';
                document.getElementById('username-display').innerText = '@' + currentUser.username;
                document.getElementById('profile-info').innerHTML = `
                    <div class="flex justify-between"><span class="text-gray-400">User ID</span><span class="text-white font-semibold">${currentUser.id}</span></div>
                    <div class="flex justify-between"><span class="text-gray-400">Username</span><span class="text-white font-semibold">${currentUser.username}</span></div>
                    <div class="flex justify-between"><span class="text-gray-400">Email</span><span class="text-white font-semibold">${currentUser.email}</span></div>
                    <div class="flex justify-between"><span class="text-gray-400">Deposit Limit</span><span class="text-white font-semibold">$${currentUser.deposit_limit}</span></div>
                    <div class="flex justify-between"><span class="text-gray-400">Withdraw Limit</span><span class="text-white font-semibold">$${currentUser.withdraw_limit}</span></div>
                    <div class="flex justify-between"><span class="text-gray-400">Status</span><span class="text-emerald-400 font-semibold">${currentUser.status}</span></div>
                `;
                document.getElementById('real-name-input').value = currentUser.real_name || '';
                document.getElementById('email-input').value = currentUser.email || '';
                document.getElementById('phone-input').value = currentUser.phone || '';
                document.getElementById('city-input').value = currentUser.city || '';
                document.getElementById('country-input').value = currentUser.country || '';
            }
        });
}

function uploadProfilePic(input) {
    if (input.files.length === 0) return;
    const file = input.files[0];
    const formData = new FormData();
    formData.append('profile_pic', file);
    fetch('/api/user/upload-profile-pic', { method: 'POST', body: formData })
        .then(r => r.json())
        .then(data => {
            alert(data.message);
            if (data.success) loadProfile();
        });
}

function updateProfile() {
    const real_name = document.getElementById('real-name-input').value.trim();
    const email = document.getElementById('email-input').value.trim();
    const phone = document.getElementById('phone-input').value.trim();
    const city = document.getElementById('city-input').value.trim();
    const country = document.getElementById('country-input').value.trim();
    fetch('/api/user/update-profile', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ real_name, email, phone, city, country })
    })
    .then(r => r.json())
    .then(data => {
        alert(data.message);
        if (data.success) loadProfile();
    });
}

function changePassword() {
    const old_password = document.getElementById('old-password').value;
    const new_password = document.getElementById('new-password').value;
    const confirm_password = document.getElementById('confirm-password').value;
    if (new_password !== confirm_password) { alert('New passwords do not match'); return; }
    fetch('/api/user/change-password', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ old_password, new_password })
    })
    .then(r => r.json())
    .then(data => {
        alert(data.message);
        if (data.success) {
            document.getElementById('old-password').value = '';
            document.getElementById('new-password').value = '';
            document.getElementById('confirm-password').value = '';
        }
    });
}

function toggleKYCForm() {
    document.getElementById('kyc-form').classList.toggle('hidden');
    const btn = document.getElementById('kyc-toggle-btn');
    btn.innerText = document.getElementById('kyc-form').classList.contains('hidden') ? 'Start KYC' : 'Cancel';
}

function submitKYC() {
    const fullName = document.getElementById('kyc-full-name').value.trim();
    const dob = document.getElementById('kyc-dob').value;
    const nationality = document.getElementById('kyc-nationality').value.trim();
    const addressLine1 = document.getElementById('kyc-address-line1').value.trim();
    const addressCity = document.getElementById('kyc-address-city').value.trim();
    const addressState = document.getElementById('kyc-address-state').value.trim();
    const addressPostal = document.getElementById('kyc-address-postal').value.trim();
    const addressCountry = document.getElementById('kyc-address-country').value.trim();
    const idType = document.getElementById('kyc-id-type').value;
    const idNumber = document.getElementById('kyc-id-number').value.trim();
    const idFront = document.getElementById('kyc-id-front').files[0];
    const idBack = document.getElementById('kyc-id-back').files[0];
    const selfie = document.getElementById('kyc-selfie').files[0];

    if (!fullName || !dob || !nationality || !addressLine1 || !addressCity || !addressState || !addressPostal || !addressCountry || !idType || !idNumber || !idFront || !idBack || !selfie) {
        alert('Please fill all required fields and upload all documents.');
        return;
    }

    const formData = new FormData();
    formData.append('full_name', fullName);
    formData.append('dob', dob);
    formData.append('nationality', nationality);
    formData.append('address_line1', addressLine1);
    formData.append('address_city', addressCity);
    formData.append('address_state', addressState);
    formData.append('address_postal', addressPostal);
    formData.append('address_country', addressCountry);
    formData.append('id_type', idType);
    formData.append('id_number', idNumber);
    formData.append('id_front', idFront);
    formData.append('id_back', idBack);
    formData.append('selfie', selfie);

    fetch('/api/user/kyc/submit', { method: 'POST', body: formData })
        .then(r => r.json())
        .then(data => {
            alert(data.message);
            if (data.success) location.reload();
        })
        .catch(err => { console.error(err); alert('Network error'); });
}

function loadKYCStatus() {
    fetch('/api/user/kyc/status')
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const badge = document.getElementById('kyc-status-badge');
                badge.textContent = data.kyc_status.toUpperCase();
                if (data.kyc_status === 'approved') {
                    badge.className = 'px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
                    document.getElementById('kyc-toggle-btn').classList.add('hidden');
                } else if (data.kyc_status === 'pending') {
                    badge.className = 'px-2 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-400 border border-amber-500/30';
                    document.getElementById('kyc-toggle-btn').classList.add('hidden');
                } else {
                    badge.className = 'px-2 py-0.5 rounded-full text-[10px] bg-gray-800 text-gray-400 border border-gray-700';
                }
            }
        })
        .catch(err => console.error(err));
}

function openAboutModal() {
    document.getElementById('about-modal').classList.remove('hidden');
}
function closeAboutModal() {
    document.getElementById('about-modal').classList.add('hidden');
}

// Initialize
loadProfile();
loadKYCStatus();

function openPasscodeModal() {
    document.getElementById('passcode-modal').classList.remove('hidden');
}

function closePasscodeModal() {
    document.getElementById('passcode-modal').classList.add('hidden');
}

function submitPasscode() {
    const oldPass = document.getElementById('old-passcode').value.trim();
    const newPass = document.getElementById('new-passcode').value.trim();
    const confirmPass = document.getElementById('confirm-passcode').value.trim();
    fetch('/api/user/change-passcode', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ old_passcode: oldPass, new_passcode: newPass, confirm_passcode: confirmPass })
    })
    .then(r => r.json())
    .then(data => {
        alert(data.message);
        if (data.success) {
            closePasscodeModal();
            document.getElementById('old-passcode').value = '';
            document.getElementById('new-passcode').value = '';
            document.getElementById('confirm-passcode').value = '';
        }
    })
    .catch(err => { console.error(err); alert('Network error'); });
}

</script>
