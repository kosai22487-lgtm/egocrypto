{% extends "base.html" %}
{% block content %}
<div class="max-w-md mx-auto px-4 pb-24 text-gray-100">
    <!-- Header -->
    <div class="flex items-center justify-between py-4">
        <button onclick="window.location.href='/'" class="text-gray-400 hover:text-white text-xl">
            <i class="fa-solid fa-arrow-left"></i>
        </button>
        <h2 class="text-lg font-bold text-white">Profile & Settings</h2>
        <div class="w-8"></div>
    </div>

    <!-- Profile Header -->
    <div class="flex items-center gap-4 bg-[#1E2533] border border-gray-800 rounded-2xl p-4 mb-6">
        <div class="relative">
            <div id="profile-avatar" class="w-14 h-14 rounded-full bg-gray-700 border-2 border-teal-500 flex items-center justify-center text-xl text-teal-400 overflow-hidden">
                <i class="fa-solid fa-user"></i>
            </div>
            <button onclick="document.getElementById('profile-pic-input').click()" class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-teal-600 hover:bg-teal-500 text-gray-950 flex items-center justify-center shadow-lg">
                <i class="fa-solid fa-camera text-[10px]"></i>
            </button>
            <input type="file" id="profile-pic-input" accept="image/*" class="hidden" onchange="uploadProfilePic(this)">
        </div>
        <div class="flex-1">
            <div id="real-name-display" class="text-white font-bold text-base">--</div>
            <div id="username-display" class="text-gray-400 text-sm">@--</div>
        </div>
        <div class="w-10 h-10 rounded-xl bg-gray-800 flex items-center justify-center text-gray-400">
            <i class="fa-solid fa-qrcode"></i>
        </div>
    </div>

    <!-- Refer & Earn Banner -->
    <div class="bg-[#1E2533] border border-gray-800 rounded-2xl p-5 mb-6 flex justify-between items-center">
        <div class="text-white font-bold text-base">Refer & Earn $50 USD</div>
        <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center text-white shadow-lg">
            <i class="fa-solid fa-coins text-xl"></i>
        </div>
    </div>

    <!-- Main Menu List -->
    <div id="main-menu" class="space-y-3 mb-8">
        <button onclick="showSection('account')" class="w-full bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between text-white text-sm hover:bg-gray-800/50 transition">
            <div class="flex items-center gap-3"><i class="fa-solid fa-user text-gray-400"></i> Account</div>
            <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
        </button>
        <button onclick="showSection('kyc')" class="w-full bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between text-white text-sm hover:bg-gray-800/50 transition">
            <div class="flex items-center gap-3"><i class="fa-solid fa-id-card text-gray-400"></i> KYC Verification</div>
            <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
        </button>
        <button onclick="showSection('security')" class="w-full bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between text-white text-sm hover:bg-gray-800/50 transition">
            <div class="flex items-center gap-3"><i class="fa-solid fa-shield-halved text-gray-400"></i> Security</div>
            <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
        </button>
        <button onclick="alert('Notifications coming soon')" class="w-full bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between text-white text-sm hover:bg-gray-800/50 transition">
            <div class="flex items-center gap-3"><i class="fa-solid fa-bell text-gray-400"></i> Notifications</div>
            <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
        </button>
        <button onclick="showAppCustomization()" class="w-full bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between text-white text-sm hover:bg-gray-800/50 transition">
            <div class="flex items-center gap-3"><i class="fa-solid fa-palette text-gray-400"></i> App Customization</div>
            <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
        </button>
        <button onclick="window.location.href='/support'" class="w-full bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between text-white text-sm hover:bg-gray-800/50 transition">
            <div class="flex items-center gap-3"><i class="fa-solid fa-headset text-gray-400"></i> Support</div>
            <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
        </button>
        <button onclick="openAboutModal()" class="w-full bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between text-white text-sm hover:bg-gray-800/50 transition">
            <div class="flex items-center gap-3"><i class="fa-solid fa-info-circle text-gray-400"></i> About</div>
            <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
        </button>
    </div>

    <!-- Account Section (Hidden) -->
    <div id="account-section" class="hidden mb-8 space-y-6">
        <button onclick="showSection('menu')" class="w-full bg-gray-800 hover:bg-gray-700 text-white font-bold py-2.5 rounded-xl text-sm transition mb-4">
            <i class="fa-solid fa-arrow-left mr-2"></i>Back to Settings
        </button>


        <!-- Profile info display -->
        <div class="bg-[#12161f] border border-gray-800 rounded-2xl p-5">
            <h3 class="text-teal-400 font-bold mb-4 text-sm"><i class="fa-solid fa-user-pen mr-2"></i>Profile Information</h3>
            <div id="profile-info" class="space-y-3 text-sm"></div>
        </div>

        <!-- Edit Profile Form -->
        <div class="bg-[#12161f] border border-gray-800 rounded-2xl p-5">
            <h3 class="text-teal-400 font-bold mb-4 text-sm"><i class="fa-solid fa-pencil mr-2"></i>Edit Profile</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Real Name</label>
                    <input type="text" id="real-name-input" placeholder="Enter your full name" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-teal-500">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Email (Gmail)</label>
                    <input type="email" id="email-input" placeholder="example@gmail.com" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-teal-500">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Phone</label>
                    <input type="tel" id="phone-input" placeholder="+959123456789" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-teal-500">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">City</label>
                        <input type="text" id="city-input" placeholder="Yangon" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-teal-500">
                    </div>
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">Country</label>
                        <input type="text" id="country-input" placeholder="Myanmar" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-teal-500">
                    </div>
                </div>
                <button onclick="updateProfile()" class="w-full bg-teal-600 hover:bg-teal-500 text-gray-950 font-bold py-3 rounded-xl text-sm transition">
                    Save Changes
                </button>
            </div>
        </div>

        <!-- Change Password -->
        <div class="bg-[#12161f] border border-gray-800 rounded-2xl p-5">
            <h3 class="text-teal-400 font-bold mb-4 text-sm"><i class="fa-solid fa-lock mr-2"></i>Change Password</h3>
            <div class="space-y-3">
                <input type="password" id="old-password" placeholder="Old Password" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-teal-500">
                <input type="password" id="new-password" placeholder="New Password" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-teal-500">
                <input type="password" id="confirm-password" placeholder="Confirm New Password" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-teal-500">
                <button onclick="changePassword()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-xl text-sm transition">
                    Update Password
                </button>
            </div>
        </div>
    </div>

    
    <!-- KYC Section (Hidden) -->
    <div id="kyc-section" class="hidden mb-8">
        <button onclick="showSection('menu')" class="w-full bg-gray-800 hover:bg-gray-700 text-white font-bold py-2.5 rounded-xl text-sm transition mb-4">
            <i class="fa-solid fa-arrow-left mr-2"></i>Back to Settings
        </button>
        <h3 class="text-teal-400 font-bold mb-4 text-sm"><i class="fa-solid fa-id-card mr-2"></i>KYC Verification</h3>
        <div class="bg-[#1E2533] border border-gray-800 rounded-xl p-4 space-y-4">
            <div class="flex items-center justify-between">
                <span class="text-white text-sm font-bold">KYC Verification</span>
                <span id="kyc-status-badge" class="px-2 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-400 border border-amber-500/30">Not Submitted</span>
            </div>
            <div id="kyc-form" class="space-y-3 hidden">
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Full Name *</label>
                    <input type="text" id="kyc-full-name" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="Your full name">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Date of Birth *</label>
                    <input type="date" id="kyc-dob" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Nationality *</label>
                    <input type="text" id="kyc-nationality" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="Your nationality">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Address Line 1 *</label>
                    <input type="text" id="kyc-address-line1" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="Street address">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">City *</label>
                        <input type="text" id="kyc-address-city" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="City">
                    </div>
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">State/Region *</label>
                        <input type="text" id="kyc-address-state" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="State/Region">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">Postal Code *</label>
                        <input type="text" id="kyc-address-postal" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="Postal code">
                    </div>
                    <div>
                        <label class="block text-xs text-gray-400 mb-1">Country *</label>
                        <input type="text" id="kyc-address-country" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="Country">
                    </div>
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">ID Type *</label>
                    <select id="kyc-id-type" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm">
                        <option value="">-- Select ID Type --</option>
                        <option value="passport">Passport</option>
                        <option value="national_id">National ID</option>
                        <option value="drivers_license">Driver's License</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">ID Number *</label>
                    <input type="text" id="kyc-id-number" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="ID Number">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Upload ID Front *</label>
                    <input type="file" id="kyc-id-front" accept=".png,.jpg,.jpeg,.pdf" class="w-full text-sm text-gray-400">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Upload ID Back *</label>
                    <input type="file" id="kyc-id-back" accept=".png,.jpg,.jpeg,.pdf" class="w-full text-sm text-gray-400">
                </div>
                <div>
                    <label class="block text-xs text-gray-400 mb-1">Upload Selfie with ID *</label>
                    <input type="file" id="kyc-selfie" accept=".png,.jpg,.jpeg" class="w-full text-sm text-gray-400">
                </div>
                <button onclick="submitKYC()" class="w-full bg-teal-600 hover:bg-teal-500 text-gray-950 font-bold py-2.5 rounded-xl text-sm transition">Submit KYC</button>
            </div>
            <button onclick="toggleKYCForm()" class="w-full bg-gray-700 hover:bg-gray-600 text-white font-bold py-2.5 rounded-xl text-sm transition" id="kyc-toggle-btn">Start KYC</button>
        </div>
    </div>

<!-- Security Section (Hidden) -->
    <div id="security-section" class="hidden mb-8">
        <button onclick="showSection('menu')" class="w-full bg-gray-800 hover:bg-gray-700 text-white font-bold py-2.5 rounded-xl text-sm transition mb-4">
            <i class="fa-solid fa-arrow-left mr-2"></i>Back to Settings
        </button>
        <h3 class="text-teal-400 font-bold mb-4 text-sm"><i class="fa-solid fa-shield-halved mr-2"></i>Security</h3>
        <div class="space-y-3">
            <div onclick="openPasscodeModal()" class="bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between cursor-pointer hover:bg-gray-800/50 transition">
                <span class="text-white text-sm">Reset Passcode</span>
                <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
            </div>
            
            <div class="bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between">
                <span class="text-white text-sm">2-Factor Authentication</span>
                <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
            </div>
            
            
            <div class="bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between">
                <span class="text-white text-sm">Anti-phishing Code</span>
                <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
            </div>
            <div class="bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between">
                <span class="text-white text-sm">Account Activity</span>
                <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
            </div>
            <div class="bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between">
                <span class="text-white text-sm">Devices</span>
                <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
            </div>
            
            <div class="bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between">
                <span class="text-white text-sm">Crypto.com Verify</span>
                <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
            </div>
            <div class="bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between">
                <span class="text-white text-sm">24-Hour Withdrawal Lock</span>
                <label class="switch"><input type="checkbox" id="withdrawal-lock-toggle"><span class="slider round"></span></label>
            </div>
        </div>
    </div>

    <!-- App Customization Section (Hidden) -->
    <div id="app-customization-section" class="hidden mb-8">
        <button onclick="document.getElementById('app-customization-section').classList.add('hidden'); document.getElementById('main-menu').classList.remove('hidden');" class="w-full bg-gray-800 hover:bg-gray-700 text-white font-bold py-2.5 rounded-xl text-sm transition mb-4">
            <i class="fa-solid fa-arrow-left mr-2"></i>Back to Settings
        </button>
        <h3 class="text-teal-400 font-bold mb-4 text-sm"><i class="fa-solid fa-palette mr-2"></i>App Theme</h3>
        <div class="space-y-3">
            <div data-theme-option="light" onclick="setTheme('light')" class="cursor-pointer bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between hover:bg-gray-800/50 transition">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-white border border-gray-300"></div>
                    <span class="text-white text-sm">Light Theme</span>
                </div>
                <i class="fa-solid fa-check text-teal-400 hidden"></i>
            </div>
            <div data-theme-option="black" onclick="setTheme('black')" class="cursor-pointer bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between hover:bg-gray-800/50 transition">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-black border border-gray-500"></div>
                    <span class="text-white text-sm">Black Theme</span>
                </div>
                <i class="fa-solid fa-check text-teal-400 hidden"></i>
            </div>
            <div data-theme-option="animated" onclick="setTheme('animated')" class="cursor-pointer bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between hover:bg-gray-800/50 transition">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-indigo-600 to-cyan-400"></div>
                    <span class="text-white text-sm">Animated Stars</span>
                </div>
                <i class="fa-solid fa-check text-teal-400 hidden"></i>
            </div>
            <div data-theme-option="matrix" onclick="setTheme('matrix')" class="cursor-pointer bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between hover:bg-gray-800/50 transition">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-green-500 to-black"></div>
                    <span class="text-white text-sm">Matrix Rain</span>
                </div>
                <i class="fa-solid fa-check text-teal-400 hidden"></i>
            </div>
            <div data-theme-option="circuit" onclick="setTheme('circuit')" class="cursor-pointer bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between hover:bg-gray-800/50 transition">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-900"></div>
                    <span class="text-white text-sm">Grid Theme</span>
                </div>
                <i class="fa-solid fa-check text-teal-400 hidden"></i>
            </div>
            <div data-theme-option="electric" onclick="setTheme('electric')" class="cursor-pointer bg-[#1E2533] border border-gray-800 rounded-xl p-4 flex items-center justify-between hover:bg-gray-800/50 transition">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-green-400 to-blue-700"></div>
                    <span class="text-white text-sm">Electric Circuit</span>
                </div>
                <i class="fa-solid fa-check text-teal-400 hidden"></i>
            </div>
            <button onclick="window.open('https://egocrypto.com/themes', '_blank')" class="w-full bg-gradient-to-r from-purple-600/20 to-blue-600/20 border border-dashed border-purple-500/50 rounded-xl p-4 flex items-center justify-center text-white text-sm hover:bg-purple-500/10 transition">
                <i class="fa-solid fa-plus mr-2 text-purple-400"></i> Add Theme
            </button>
        </div>
    </div>

    <!-- Log Out -->
    <button onclick="window.location.href='/logout'" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 rounded-xl text-sm transition mb-6">
        Log Out
    </button>

    <p class="text-center text-xs text-gray-500">Egocrypto App Version 1.0.0</p>
</div>


<!-- Reset Passcode Modal -->
<div id="passcode-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 w-full max-w-sm space-y-4">
        <div class="flex justify-between items-center">
            <h3 class="text-lg font-bold text-teal-400">Reset Passcode</h3>
            <button onclick="closePasscodeModal()" class="text-gray-400 hover:text-white text-xl"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div id="old-passcode-field" class="space-y-1">
            <label class="block text-xs text-gray-400">Old Passcode</label>
            <input type="password" id="old-passcode" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="Enter old passcode">
        </div>
        <div class="space-y-1">
            <label class="block text-xs text-gray-400">New Passcode (4-6 digits)</label>
            <input type="password" id="new-passcode" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="New passcode">
        </div>
        <div class="space-y-1">
            <label class="block text-xs text-gray-400">Confirm New Passcode</label>
            <input type="password" id="confirm-passcode" class="w-full bg-gray-950 border border-gray-700 rounded-xl px-3 py-2 text-white text-sm" placeholder="Confirm new passcode">
        </div>
        <button onclick="submitPasscode()" class="w-full bg-teal-600 hover:bg-teal-500 text-gray-950 font-bold py-2.5 rounded-xl text-sm transition">Save Passcode</button>
    </div>
</div>

<!-- About Egocrypto Modal -->
<div id="about-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 max-w-md w-full max-h-[85vh] overflow-y-auto shadow-2xl">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold text-teal-400"><i class="fa-solid fa-info-circle mr-2"></i>About Egocrypto</h3>
            <button onclick="closeAboutModal()" class="text-gray-400 hover:text-white transition text-xl"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="space-y-5 text-sm text-gray-300">
            <div class="bg-gradient-to-r from-indigo-600/20 to-cyan-500/20 border border-indigo-500/30 rounded-2xl p-5">
                <h4 class="text-white font-bold text-lg mb-2">Trade Smarter. Move Faster.</h4>
                <p class="leading-relaxed">Egocrypto is a next-generation trading platform designed to deliver clarity, speed, and confidence to users of all experience levels.</p>
            </div>
            <div>
                <h4 class="text-teal-400 font-bold mb-2"><i class="fa-solid fa-bullseye mr-2"></i>Our Vision & Mission</h4>
                <p class="leading-relaxed mb-2"><strong class="text-white">Vision:</strong> To become the world's most trusted and user-friendly crypto trading platform.</p>
                <p class="leading-relaxed"><strong class="text-white">Mission:</strong> To bridge the gap between complex trading tools and everyday users.</p>
            </div>
            <div>
                <h4 class="text-teal-400 font-bold mb-2"><i class="fa-solid fa-book-open mr-2"></i>Our Story</h4>
