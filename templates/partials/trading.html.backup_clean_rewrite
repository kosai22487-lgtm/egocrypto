</script>
    <script>
        let chart, candleSeries;
        let currentCoinId = 'bitcoin';
        let currentSymbol = 'BTCUSDT';
        let currentPrice = 0;
        let userBalance = 0;
        let selectedDuration = 30;
        let selectedProfitPercent = 40;
        let activeTradeId = null;
        let countdownInterval = null;

        function selectPair(seconds, profit, btn) {
            selectedDuration = seconds;
            selectedProfitPercent = profit;
            document.getElementById('selected-spec-badge').innerText = `${seconds}s • ${profit}% ROI`;
            document.querySelectorAll('.pair-btn').forEach(b => {
                b.className = "pair-btn bg-[#0b0e14] border border-gray-700/80 text-gray-300 hover:border-teal-500/60 font-bold p-2.5 rounded-xl text-xs flex flex-col items-center justify-center transition cursor-pointer";
                const topSpan = b.querySelector('span:nth-child(1)');
                const subSpan = b.querySelector('span:nth-child(2)');
                if(topSpan) topSpan.className = "text-sm font-black text-white";
                if(subSpan) subSpan.className = "text-[10px] text-teal-400 font-semibold mt-0.5";
            });
            btn.className = "pair-btn bg-teal-500 text-gray-950 font-bold p-2.5 rounded-xl text-xs flex flex-col items-center justify-center shadow-md shadow-teal-500/15 transition cursor-pointer";
            const activeTop = btn.querySelector('span:nth-child(1)');
            const activeSub = btn.querySelector('span:nth-child(2)');
            if(activeTop) activeTop.className = "text-sm font-black";
            if(activeSub) activeSub.className = "text-[10px] font-semibold opacity-90 mt-0.5";
        }

        async function fetchBalance() {
            try {
                const resp = await fetch('/api/data');
                const data = await resp.json();
                userBalance = data.balance;
                document.getElementById('balance-display').innerText = 'Balance: $' + userBalance.toFixed(2);
            } catch (err) { console.error(err); }
        }

        function initChart() {
            if (typeof LightweightCharts === 'undefined') {
                console.warn('Chart library not ready, retrying...');
                setTimeout(initChart, 500);
                return;
            }
            document.getElementById('chartContainer').innerHTML = '';
            chart = LightweightCharts.createChart(document.getElementById('chartContainer'), {
                width: document.getElementById('chartContainer').clientWidth,
                height: 320,
                layout: { background: { type: 'solid', color: '#0b0e14' }, textColor: '#9ca3af' },
                grid: { vertLines: { color: '#1f2937' }, horzLines: { color: '#1f2937' } },
                timeScale: { borderColor: '#374151', timeVisible: true },
            });
            candleSeries = chart.addCandlestickSeries({
                upColor: '#10b981', downColor: '#f43f5e', borderVisible: false,
                wickColor: '#10b981', wickDownColor: '#f43f5e',
            });
        }

        function generateFallbackCandles() {
            const data = [];
            const now = Math.floor(Date.now() / 1000);
            let price = 65000;
            for (let i = 48; i >= 0; i--) {
                const time = now - i * 3600;
                const open = price;
                const close = open + (Math.random() - 0.5) * 200;
                const high = Math.max(open, close) + Math.random() * 100;
                const low = Math.min(open, close) - Math.random() * 100;
                data.push({ time, open, high, low, close });
                price = close;
            }
            return data;
        }

        async function loadChartData() {
            try {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 5000);
                const resp = await fetch(`/api/trading-data/${currentCoinId}`, { signal: controller.signal });
                clearTimeout(timeoutId);
                const result = await resp.json();
                if (result.success && result.ohlc && result.ohlc.length > 2) {
                    const formattedData = result.ohlc.map(c => ({
                        time: Math.floor(c[0] / 1000), open: c[1], high: c[2], low: c[3], close: c[4]
                    }));
                    candleSeries.setData(formattedData);
                    if (result.current_price > 0) {
                        currentPrice = result.current_price;
                    }
                } else {
                    throw new Error('No data');
                }
            } catch (err) {
                console.warn('Falling back to generated candles:', err);
                candleSeries.setData(generateFallbackCandles());
                currentPrice = currentPrice || 65000;
            }

            if (candleSeries.data().length > 0) {
                const last = candleSeries.data()[candleSeries.data().length - 1];
                currentPrice = last.close;
                document.getElementById('livePrice').innerText = "$" + currentPrice.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const first = candleSeries.data()[0];
                const change = ((last.close - first.open) / first.open) * 100;
                const ce = document.getElementById('priceChange');
                ce.innerText = (change >= 0 ? "+" : "") + change.toFixed(2) + "%";
                ce.className = change >= 0 ? "text-xs font-semibold px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-400" : "text-xs font-semibold px-2.5 py-1 rounded-lg bg-rose-500/20 text-rose-400";
                updateCryptoAmount();
            }
        }

        function updateCryptoAmount() {
            const usdtAmount = parseFloat(document.getElementById('trade-usdt-amount').value) || 0;
            if (currentPrice > 0) {
                const cryptoAmount = usdtAmount / currentPrice;
                document.getElementById('crypto-amount-display').innerText = cryptoAmount.toFixed(6);
                document.getElementById('crypto-symbol-display').innerText = currentSymbol.replace('USDT', '');
            }
        }

        async function executeTrade(type) {
            const usdtAmount = parseFloat(document.getElementById('trade-usdt-amount').value);
            if (!usdtAmount || usdtAmount <= 0) { alert('Please enter a valid USDT amount.'); return; }
            if (currentPrice <= 0) { alert('Price not available. Please wait.'); return; }

            const cryptoAmount = usdtAmount / currentPrice;
            try {
                const resp = await fetch('/api/trade', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ type, symbol: currentSymbol, amount: cryptoAmount, price: currentPrice, duration: selectedDuration, profit_percent: selectedProfitPercent })
                });
                const result = await resp.json();
                if (result.success) {
                    activeTradeId = result.trade_id;
                    showCountdownModal(type, (usdtAmount * selectedProfitPercent) / 100);
                    document.getElementById('trade-usdt-amount').value = '';
                    document.getElementById('crypto-amount-display').innerText = '0.00';
                    fetchBalance();
                } else { alert('Error: ' + result.message); }
            } catch (err) { console.error(err); alert('Trade failed.'); }
        }

        function showCountdownModal(type, expectedProfit) {
            let timeLeft = selectedDuration;
            const modal = document.getElementById('tradeModal');
            modal.classList.remove('hidden');
            document.getElementById('modalTitle').innerText = "Trade in Progress...";
            document.getElementById('modalSubtitle').innerText = `Waiting for position to close (${timeLeft}s remaining)`;
            document.getElementById('resType').innerText = type.toUpperCase() + (type === 'buy' ? ' / LONG' : ' / SHORT');
            document.getElementById('resSymbol').innerText = currentSymbol;
            document.getElementById('resPrice').innerText = '$' + currentPrice.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('resDuration').innerHTML = `<span id="timerCount" class="text-teal-400 font-bold">${timeLeft}</span> Seconds`;
            document.getElementById('resRoi').innerText = selectedProfitPercent + '%';
            document.getElementById('resPnl').innerText = '+' + expectedProfit.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USDT';
            
            const iconContainer = document.getElementById('modalIconContainer');
            const modalIcon = document.getElementById('modalIcon');
            iconContainer.className = "w-16 h-16 rounded-full flex items-center justify-center mx-auto shadow-lg bg-teal-500/20 text-teal-400 border border-teal-500/30 mt-1";
            modalIcon.className = "fa-solid fa-spinner fa-spin text-2xl text-teal-400";

            if (countdownInterval) clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                timeLeft--;
                const timerElem = document.getElementById('timerCount');
                if (timerElem) timerElem.innerText = timeLeft;
                document.getElementById('modalSubtitle').innerText = `Waiting for position to close (${timeLeft}s remaining)`;
                if (timeLeft <= 0) {
                    clearInterval(countdownInterval);
                    resolveTrade(activeTradeId);
                }
            }, 1000);
        }

        async function resolveTrade(tradeId) {
            try {
                const resp = await fetch(`/api/resolve-trade/${tradeId}`, { method: 'POST' });
                const res = await resp.json();
                const iconContainer = document.getElementById('modalIconContainer');
                const modalIcon = document.getElementById('modalIcon');
                if (res.success) {
                    document.getElementById('modalTitle').innerText = "Trade Closed Successfully";
                                    if (res.result === 'win') {
                    document.getElementById('modalTitle').innerText = "Congratulations 🎉 You Win!";
                    document.getElementById('modalSubtitle').innerText = "Your position won!";
                    iconContainer.className = "w-16 h-16 rounded-full flex items-center justify-center mx-auto shadow-lg bg-yellow-400/20 text-yellow-400 border border-yellow-400/30 mt-1";
                    modalIcon.className = "fa-solid fa-trophy text-3xl text-yellow-400";
                    fireConfetti();
                    document.getElementById('resPnl').innerHTML = `<span class="text-emerald-400 font-bold">+${res.profit_amount.toFixed(2)} USDT (WIN)</span>`;
                } USDT (WIN)</span>`;
                    } else {
                        document.getElementById('modalSubtitle').innerText = "Position closed in loss.";
                        iconContainer.className = "w-16 h-16 rounded-full flex items-center justify-center mx-auto shadow-lg bg-rose-500/20 text-rose-400 border border-rose-500/30 mt-1";
                        modalIcon.className = "fa-solid fa-triangle-exclamation text-2xl text-rose-400";
                        document.getElementById('resPnl').innerHTML = `<span class="text-rose-400 font-bold">-${res.profit_amount.toFixed(2)} USDT (LOSS)</span>`;
                    }
                    fetchBalance();
                }
            } catch (err) { console.error(err); }
        }

        function closeModal() {
            if (countdownInterval) clearInterval(countdownInterval);
            document.getElementById('tradeModal').classList.add('hidden');
        }

        function toggleCoinDropdown() {
            document.getElementById('coinDropdownList').classList.toggle('hidden');
        }

        function selectCoin(coinId, symbol, displaySymbol, displayName) {
            currentCoinId = coinId;
            currentSymbol = symbol;
            document.getElementById('selected-coin-symbol').innerText = displaySymbol;
            document.getElementById('selected-coin-name').innerText = displayName;
            document.getElementById('coinTitle').innerText = displaySymbol + " Price";
            document.getElementById('crypto-symbol-display').innerText = displaySymbol.split('/')[0];
            document.getElementById('coinDropdownList').classList.add('hidden');
            document.getElementById('livePrice').innerText = "Loading...";
            document.getElementById('priceChange').innerText = "--%";
            document.getElementById('trade-usdt-amount').value = '';
            document.getElementById('crypto-amount-display').innerText = '0.00';
            loadChartData();
        }

        window.onclick = function(e) {
            if (!e.target.closest('#coinDropdownList') && !e.target.closest('div[onclick="toggleCoinDropdown()"]')) {
                document.getElementById('coinDropdownList').classList.add('hidden');
            }
        }

        fetchBalance();
        initChart();
        loadChartData();
        setInterval(loadChartData, 60000);

        // Handle coin selection from Markets page via URL params
        (function() {
            const params = new URLSearchParams(window.location.search);
            const coinId = params.get('coin');
            if (coinId) {
                const symbol = params.get('symbol') || 'BTCUSDT';
                const name = params.get('name') || 'Bitcoin';
                currentCoinId = coinId;
