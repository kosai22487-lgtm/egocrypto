                <div class="flex justify-between border-t border-gray-800/60 pt-2"><span class="text-gray-400">Trading Pair</span><span id="resSymbol" class="font-bold text-teal-400">-</span></div>
                <div class="flex justify-between border-t border-gray-800/60 pt-2"><span class="text-gray-400">Entry Price</span><span id="resPrice" class="font-bold text-white">-</span></div>
