    <script>
        let currentBalance = 0;
        let dashboardBalanceVisible = true;
        let walletBalanceVisible = true;

        function setActiveSidebar(el) {
            document.querySelectorAll('.sidebar-link').forEach(l => l.classList.remove('active'));
            el.classList.add('active');
        }

        function updateTime() {
            const now = new Date();
            const timeStr = now.toLocaleString(undefined, {
                weekday: 'short', year: 'numeric', month: 'short', day: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true
            });
            const timeEl = document.getElementById('time-string');
            if(timeEl) timeEl.innerText = timeStr;
        }
        setInterval(updateTime, 1000);
        updateTime();

        fetch('/api/data').then(r => r.json()).then(d => {
            currentBalance = d.balance;
            document.getElementById('welcome-title').innerText = 'Welcome back, ' + d.name;
            document.getElementById('user-id-badge').innerHTML = '<span>User ID: ' + d.id + '</span>';
            updateDashboardBalance();
            document.getElementById('modal-balance').innerText = '$' + d.balance.toFixed(2);
            updateWalletTotalBalanceDisplay();
            updatePortfolioAndDepositCards();
            fetchWalletBalances();
        }).catch(err => console.error('API Error:', err));

        function switchTab(tab) {
            document.getElementById('view-home').classList.add('hidden');
            document.getElementById('view-wallet').classList.add('hidden');
            document.getElementById('view-deposit').classList.add('hidden');
            const homeBtn = document.getElementById('nav-home-btn');
            const walletBtn = document.getElementById('nav-wallet-btn');
            if(tab === 'home') {
                document.getElementById('view-home').classList.remove('hidden');
                homeBtn.className = "flex flex-col items-center justify-center w-12 h-12 rounded-2xl bg-teal-500/10 border border-teal-500/30 text-teal-400 transition shadow-lg cursor-pointer";
                walletBtn.className = "flex flex-col items-center justify-center w-12 h-12 rounded-2xl text-gray-400 hover:text-gray-300 transition cursor-pointer";
            } else if(tab === 'wallet') {
                document.getElementById('view-wallet').classList.remove('hidden');
                walletBtn.className = "flex flex-col items-center justify-center w-12 h-12 rounded-2xl bg-teal-500/10 border border-teal-500/30 text-teal-400 transition shadow-lg cursor-pointer";
                homeBtn.className = "flex flex-col items-center justify-center w-12 h-12 rounded-2xl text-gray-400 hover:text-gray-300 transition cursor-pointer";
                fetchWalletBalances();
            }
        }

        function openDepositView() {
            document.getElementById('view-home').classList.add('hidden');
            document.getElementById('view-wallet').classList.add('hidden');
            document.getElementById('view-deposit').classList.remove('hidden');
            loadDepositAddresses();
        }

        function toggleDashboardBalanceVisibility() {
            dashboardBalanceVisible = !dashboardBalanceVisible;
            updateDashboardBalance();
        }

        function updateDashboardBalance() {
            const el = document.getElementById('balance-val');
            const icon = document.getElementById('dashboard-eye-icon');
            if(dashboardBalanceVisible) {
                el.innerText = '$' + currentBalance.toFixed(2);
                icon.className = "fa-regular fa-eye text-gray-400 cursor-pointer text-xl hover:text-white transition";
            } else {
                el.innerText = '••••••';
                icon.className = "fa-regular fa-eye-slash text-gray-400 cursor-pointer text-xl hover:text-white transition";
            }
        }

        function toggleWalletBalanceVisibility() {
            walletBalanceVisible = !walletBalanceVisible;
            updateWalletTotalBalanceDisplay();
        }

        function updateWalletTotalBalanceDisplay() {
            const el = document.getElementById('wallet-total-balance');
            const icon = document.getElementById('wallet-eye-icon');
            if(walletBalanceVisible) {
                el.innerText = '$' + currentBalance.toFixed(2);
                icon.className = "fa-regular fa-eye text-gray-400 cursor-pointer text-xl hover:text-white transition";
            } else {
                el.innerText = '••••••';
                icon.className = "fa-regular fa-eye-slash text-gray-400 cursor-pointer text-xl hover:text-white transition";
            }
        }

        function updatePortfolioAndDepositCards() {
            const portfolioCard = document.getElementById('portfolio-card');
            const depositCard = document.getElementById('deposit-required-card');
            const statusEl = document.getElementById('portfolio-status');
            const subEl = document.getElementById('portfolio-subtitle');
            if(currentBalance > 0) {
                portfolioCard.classList.remove('hidden');
                if(depositCard) depositCard.classList.add('hidden');
                statusEl.innerText = 'Active ($' + currentBalance.toFixed(2) + ')';
                subEl.innerText = 'Portfolio is active';
            } else {
                portfolioCard.classList.remove('hidden');
                if(depositCard) depositCard.classList.remove('hidden');
                statusEl.innerText = 'Inactive';
                subEl.innerText = 'Deposit to begin';
            }
        }

        function toggleMenu() {
            const sb = document.getElementById('sidebar');
            const bd = document.getElementById('sidebar-backdrop');
            sb.classList.toggle('open');
            bd.classList.toggle('open');
        }

        function toggleActionModal() {
            const m = document.getElementById('action-modal');
            m.classList.toggle('hidden');
        }

        function openWithdrawModal() {
            document.getElementById('withdraw-modal').classList.remove('hidden');
            toggleActionModal();
        }

        function closeWithdrawModal() {
            document.getElementById('withdraw-modal').classList.add('hidden');
        }

        function openHistoryModal() {
            document.getElementById('history-modal').classList.remove('hidden');
            fetchHistory();
        }

        function closeHistoryModal() {
            document.getElementById('history-modal').classList.add('hidden');
        }

        function copyAddress(elId, spanId) {
            const text = document.getElementById(elId).innerText;
            navigator.clipboard.writeText(text);
            const s = document.getElementById(spanId);
            s.classList.remove('hidden');
            setTimeout(() => s.classList.add('hidden'), 2000);
        }

        function submitDepositRequest() {
            const amount = document.getElementById('deposit-amount').value;
            const coin = document.getElementById('deposit-coin').value;
            const tx_hash = document.getElementById('deposit-tx').value;
            if(!amount || !tx_hash) {
                alert('Please fill in all fields.');
                return;
            }
            fetch('/api/deposit-request', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({amount, coin, tx_hash})
            }).then(r => r.json()).then(d => {
                if(d.success) {
                    alert('Deposit request submitted successfully.');
                    switchTab('home');
                } else {
                    alert(d.error || 'Error submitting request');
                }
            });
        }

        function loadDepositAddresses() {
            fetch('/api/deposit-addresses').then(r => r.json()).then(d => {
                if(d.BTC) document.getElementById('addr-deposit-btc').innerText = d.BTC;
                if(d.ETH) document.getElementById('addr-deposit-eth').innerText = d.ETH;
                if(d.USDT) document.getElementById('addr-deposit-usdc').innerText = d.USDT;
            });
        }

        function fetchWalletBalances() {
            fetch('/api/wallet/all').then(r => r.json()).then(d => {
                const c = document.getElementById('wallet-coins-container');
                let html = '';
                d.forEach(coin => {
                    html += `<div class="glass-card p-4 flex justify-between items-center">
                        <div class="flex items-center space-x-3">
                            <img src="https://assets.coincap.io/assets/icons/${coin.symbol.toLowerCase()}@2x.png" alt="${coin.symbol}" class="w-8 h-8 rounded-full" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="w-10 h-10 rounded-xl bg-gray-800 flex items-center justify-center font-bold text-white" style="display:none;">${coin.symbol}</div>
                            <div>
                                <div class="text-white font-bold text-sm">${coin.name}</div>
                                <div class="text-xs text-gray-400">Balance</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-white font-bold text-sm">${coin.balance.toFixed(4)}</div>
                            <div class="text-xs text-emerald-400">${coin.symbol}</div>
                        </div>
                    </div>`;
                });
                c.innerHTML = html;
            });
        }

        function checkWithdrawLimit() {
            const amt = parseFloat(document.getElementById('withdraw-amount').value);
            const btn = document.getElementById('confirm-withdraw-btn');
            const err = document.getElementById('exceed-error');
            if(amt > currentBalance) {
                err.classList.remove('hidden');
                btn.disabled = true;
                btn.className = "w-full bg-blue-600/50 text-white font-bold py-3 rounded-xl text-sm transition cursor-not-allowed";
            } else {
                err.classList.add('hidden');
                if(amt > 0) {
                    btn.disabled = false;
                    btn.className = "w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-xl text-sm transition shadow-lg cursor-pointer";
                }
            }
        }

        function submitWithdraw() {
            const amount = document.getElementById('withdraw-amount').value;
            const address = document.getElementById('withdraw-address').value;
            if(!amount || !address) {
                alert('Please enter amount and address.');
                return;
            }
            fetch('/api/withdraw-request', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({amount, address})
            }).then(r => r.json()).then(d => {
                if(d.success) {
                    alert('Withdrawal request submitted.');
                    closeWithdrawModal();
                } else {
                    alert(d.error || 'Withdrawal failed');
                }
            });
        }

        function fetchHistory() {
            fetch('/api/transactions').then(r => r.json()).then(d => {
                const h = document.getElementById('history-list');
                if(d.length === 0) {
                    h.innerHTML = '<p class="text-center text-gray-400 py-6">No transaction history found.</p>';
                    return;
                }
                let html = '';
                d.forEach(item => {
                    html += `<div class="bg-gray-900 border border-gray-800 p-3 rounded-xl flex justify-between items-center">
                        <div>
                            <div class="text-white font-bold">${item.type}</div>
                            <div class="text-[10px] text-gray-400">${item.created_at}</div>
                        </div>
                        <div class="text-right">
                            <div class="text-teal-400 font-bold">$${item.amount.toFixed(2)}</div>
                            <div class="text-[10px] text-yellow-500">${item.description}</div>
                        </div>
                    </div>`;
                });
                h.innerHTML = html;
            });
        }

        // Live Price ticker simulation
        setInterval(() => {
            const btcP = (64000 + Math.random() * 200).toFixed(2);
            const ethP = (3400 + Math.random() * 50).toFixed(2);
            const el1 = document.getElementById('btc-main-price');
            const el2 = document.getElementById('btc-grid-price');
            const el3 = document.getElementById('eth-grid-price');
            if(el1) el1.innerText = '$' + Number(btcP).toLocaleString();
            if(el2) el2.innerText = '$' + Number(btcP).toLocaleString();
            if(el3) el3.innerText = '$' + Number(ethP).toLocaleString();
        }, 3000);
    
    let deferredPrompt;

    window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
    });

    function installApp() {
        if (deferredPrompt) {
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then((choiceResult) => {
                if (choiceResult.outcome === 'accepted') {
                    alert('Egocrypto installed successfully!');
                }
                deferredPrompt = null;
            });
        } else {
            alert('Please use Chrome browser and tap "Add to Home Screen" from menu.');
        }
    }


    function downloadApp() {
        alert('Step 1: Tap the three dots at top right\nStep 2: Select Add to Home Screen\nStep 3: Tap Install');
    }


    function loadRecentTrade() {
        fetch('/api/trade/history').then(r => r.json()).then(data => {
            const container = document.getElementById('recent-trades-list');
            if (data.length === 0) {
                container.innerHTML = '<p class="text-center py-6">No trades yet</p>';
                return;
            }
            const t = data[0];  // latest trade only
            const resultColor = t.result === 'win' ? 'text-emerald-400' : t.result === 'loss' ? 'text-rose-400' : 'text-gray-400';
            container.innerHTML = `
                <div class="bg-gray-900 border border-gray-800 p-4 rounded-xl cursor-pointer" onclick="openTradeDetail(${t.id})">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-white font-bold">${t.symbol}</span>
                        <span class="${resultColor} font-bold">${t.result ? t.result.toUpperCase() : t.status.toUpperCase()}</span>
                    </div>
                    <div class="text-gray-400">${t.trade_type.toUpperCase()} | $${t.amount.toFixed(2)} | ${t.duration}s</div>
                </div>
            `;
        }).catch(err => {
            document.getElementById('recent-trades-list').innerHTML = '<p class="text-center py-6">Failed to load trade</p>';
        });
    }

    loadRecentTrade();


    function loadMonthlyTradesCount() {
        fetch('/api/trade/history').then(r => r.json()).then(data => {
