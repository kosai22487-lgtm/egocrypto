            <div class="w-14 h-14 rounded-full bg-[#1e88e5] hover:bg-blue-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/30 transition border-4 border-[#0b0e14]">
                <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 8h14l-3-3"></path>
                    <path d="M20 16H6l3 3"></path>
                </svg>
            </div>
        </button>
        <button type="button" onclick="switchTab('wallet')" id="nav-wallet-btn" class="flex flex-col items-center justify-center w-12 h-12 rounded-2xl text-gray-400 hover:text-gray-300 transition cursor-pointer">
            <i class="fa-solid fa-wallet text-lg"></i>
        </button>
