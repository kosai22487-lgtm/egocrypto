    <nav class="fixed bottom-0 left-0 right-0 bg-[#0b0e14] border-t border-gray-800/80 px-12 pt-4 pb-6 z-40 max-w-lg mx-auto flex justify-between items-center shadow-2xl">
        <button type="button" onclick="switchTab('home')" id="nav-home-btn" class="flex flex-col items-center justify-center w-12 h-12 rounded-2xl bg-teal-500/10 border border-teal-500/30 text-teal-400 transition shadow-lg cursor-pointer">
            <i class="fa-solid fa-house text-lg"></i>
