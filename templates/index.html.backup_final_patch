    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4">
    let deferredPrompt;

    window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
    });

    function installApp() {
        if (deferredPrompt) {
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then((choiceResult) => {
                if (choiceResult.outcome === 'accepted') {
                    alert('Egocrypto installed successfully!');
                }
                deferredPrompt = null;
            });
        } else {
            alert('Please use Chrome browser and tap "Add to Home Screen" from menu.');
        }
    }


    function downloadApp() {
        alert('Step 1: Tap the three dots at top right\nStep 2: Select Add to Home Screen\nStep 3: Tap Install');
    }


    function loadRecentTrade() {
        fetch('/api/trade/history').then(r => r.json()).then(data => {
            const container = document.getElementById('recent-trades-list');
            if (data.length === 0) {
                container.innerHTML = '<p class="text-center py-6">No trades yet</p>';
                return;
            }
            const t = data[0];  // latest trade only
            const resultColor = t.result === 'win' ? 'text-emerald-400' : t.result === 'loss' ? 'text-rose-400' : 'text-gray-400';
            container.innerHTML = `
                <div class="bg-gray-900 border border-gray-800 p-4 rounded-xl cursor-pointer" onclick="openTradeDetail(${t.id})">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-white font-bold">${t.symbol}</span>
                        <span class="${resultColor} font-bold">${t.result ? t.result.toUpperCase() : t.status.toUpperCase()}</span>
                    </div>
                    <div class="text-gray-400">${t.trade_type.toUpperCase()} | $${t.amount.toFixed(2)} | ${t.duration}s</div>
                </div>
            `;
        }).catch(err => {
            document.getElementById('recent-trades-list').innerHTML = '<p class="text-center py-6">Failed to load trade</p>';
        });
    }

    loadRecentTrade();


    function loadMonthlyTradesCount() {
        fetch('/api/trade/history').then(r => r.json()).then(data => {
            const now = new Date();
            const currentMonth = now.getMonth();
            const currentYear = now.getFullYear();
            const monthlyTrades = data.filter(t => {
                const tradeDate = new Date(t.created_at);
                return tradeDate.getMonth() === currentMonth && tradeDate.getFullYear() === currentYear;
            });
            document.getElementById('monthly-trades-count').innerText = monthlyTrades.length;
        }).catch(err => {
            document.getElementById('monthly-trades-count').innerText = '0';
        });
    }

    loadMonthlyTradesCount();


    // Prevent back button from logging out
    history.pushState(null, '', location.href);
    window.addEventListener('popstate', function() {
        history.pushState(null, '', location.href);
    });


    function updateNotificationDot() {
        fetch('/api/notifications').then(r => r.json()).then(data => {
            const badge = document.getElementById('notification-badge');
            if (badge) {
                if (data.length > 0) {
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }
        });
    }

    updateNotificationDot();

</script>
