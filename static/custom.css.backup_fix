
/* ===== GLOBAL DESIGN ENHANCEMENTS ===== */
body {
    background: #0B0E14 !important;
    background-image:
        radial-gradient(ellipse at top left, rgba(79,70,229,0.15), transparent 50%),
        radial-gradient(ellipse at bottom right, rgba(13,148,136,0.15), transparent 50%),
        radial-gradient(circle at center, rgba(30,58,138,0.05), transparent 70%) !important;
    background-attachment: fixed;
    min-height: 100vh;
}

/* Glassmorphism Card */
.glass-card, .card, .bg-gray-900, .bg-gray-950, .bg-[#12161f], .bg-[#1B212C], .feature-card, .grid-item {
    backdrop-filter: blur(12px);
    background: rgba(255,255,255,0.05) !important;
    border: 1px solid rgba(255,255,255,0.1) !important;
    border-radius: 1.2rem !important;
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* Card Hover */
.glass-card:hover, .card:hover, .bg-gray-900:hover, .bg-gray-950:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.5), 0 0 15px rgba(45,212,191,0.2);
}

/* Fade-in / Slide-up Animation */
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

.fade-up {
    animation: fadeInUp 0.6s ease forwards;
}

/* Count-up number */
.count-up {
    font-variant-numeric: tabular-nums;
}

/* Buttons Gradient */
.btn-primary, .auth-btn-gradient, .bg-blue-600, .bg-indigo-600, .bg-teal-600, .bg-emerald-600 {
    background: linear-gradient(135deg, #4F46E5, #06B6D4) !important;
    border: none;
    color: white !important;
    box-shadow: 0 4px 15px rgba(79,70,229,0.3);
    transition: opacity 0.2s, transform 0.1s;
}

.btn-primary:hover, .auth-btn-gradient:hover, .bg-blue-600:hover, .bg-indigo-600:hover, .bg-teal-600:hover, .bg-emerald-600:hover {
    opacity: 0.9;
    transform: scale(1.02);
}

/* Sidebar & Bottom Nav Glass */
#sidebar, nav.fixed.bottom-0, header {
    backdrop-filter: blur(16px);
    background: rgba(11,14,20,0.8) !important;
    border-color: rgba(255,255,255,0.1) !important;
}

.sidebar-link.active {
    background: linear-gradient(135deg, rgba(45,212,191,0.2), rgba(79,70,229,0.2)) !important;
    border: 1px solid rgba(45,212,191,0.3) !important;
    color: #2dd4bf !important;
}

.sidebar-link:hover {
    background: rgba(255,255,255,0.05) !important;
}

/* Floating Background Blobs */
@keyframes floatBlob {
    0% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
    100% { transform: translateY(0) rotate(360deg); }
}

.background-blob {
    position: fixed;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.3;
    z-index: -1;
    pointer-events: none;
}

.blob-1 { background: #4F46E5; top: -50px; left: -50px; animation: floatBlob 8s infinite; }
.blob-2 { background: #06B6D4; bottom: -50px; right: -50px; animation: floatBlob 10s infinite reverse; }
.blob-3 { background: #8B5CF6; top: 40%; left: 60%; animation: floatBlob 12s infinite; }

/* Particle Canvas */
#particle-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
}


/* ===== Header Transparent Override ===== */
header {
    background: transparent !important;
    backdrop-filter: none !important;
    border: none !important;
    box-shadow: none !important;
}
